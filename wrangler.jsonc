{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truthfitresume",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "truthfitresume-db", "database_id": "d3b2a624-e2c6-460a-a42d-17e4eb49c3fc", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": true }
}
