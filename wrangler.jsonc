{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truthfitresume",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
